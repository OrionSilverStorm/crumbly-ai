# Copy to .env and fill in. Never commit .env. Everything has a local default so `make dev` runs offline.

# ---- Time & demo ----
APP_TZ=Europe/London
SCENARIO=happy                    # happy | short_confirm | new_supplier_wins | owner_rejects
DEMO_TIME_SCALE=60                # 60 = a 30-minute chase happens in 30 s (badge shown in the UI)
SUPPLIER_BOT_INPROCESS=1          # run the scripted supplier bot inside the app process
OWNER_ID=owner

# ---- Live state (Lakebase) ----
DB_MODE=embedded                  # embedded (pgserver, local) | postgres (DATABASE_URL) | lakebase
DATABASE_URL=                     # e.g. postgresql://crumbly:crumbly@localhost:5432/crumbly (docker-compose)
PGDATA_DIR=                       # embedded data dir (default ./.pgdata)
LAKEBASE_ENDPOINT=                # Autoscaling: projects/<p>/branches/<b>/endpoints/<e>
LAKEBASE_INSTANCE=                # Provisioned: instance name (used if LAKEBASE_ENDPOINT is empty)
# PGHOST, PGUSER, PGDATABASE, PGPORT, PGSSLMODE are injected by Databricks Apps for a database resource;
# set them yourself when running locally against Lakebase.

# ---- Databricks (warehouse, model serving, auth) ----
WAREHOUSE_MODE=local              # local (Postgres mirror) | databricks
DATABRICKS_HOST=                  # https://<workspace>.cloud.databricks.com (local dev only; Apps inject auth)
DATABRICKS_TOKEN=                 # PAT for local dev only
DATABRICKS_WAREHOUSE_ID=
UC_CATALOG=crumbly
UC_SCHEMA=bakery

# ---- LLM ----
LLM_PROVIDER=stub                 # databricks | openai | stub (tests/offline only)
LLM_ENDPOINT=databricks-claude-sonnet-4-5
OPENAI_BASE_URL=                  # for LLM_PROVIDER=openai (any OpenAI-compatible API, e.g. Adaption)
OPENAI_API_KEY=
AI_QUERY_ENABLED=1                # use SQL ai_query for bronze -> silver (falls back to the LLM client)
AI_QUERY_TIMEOUT_S=8

# ---- Email (two Gmail accounts with 2-Step Verification + app passwords, IMAP enabled) ----
EMAIL_MODE=memory                 # gmail | memory (in-process, offline)
EMAIL_BAKERY_ADDRESS=bakery@crumbly.test
EMAIL_BAKERY_PASSWORD=            # app password
EMAIL_SUPPLIERS_ADDRESS=suppliers@crumbly.test   # every supplier is a +plus-address of this mailbox
EMAIL_SUPPLIERS_PASSWORD=         # app password
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_POLL_SECONDS=10

# ---- Linkup ----
LINKUP_API_KEY=
LINKUP_MODE=live                  # live | fixture (bundled fictional Thames Grain responses for the scripted demo)
LINKUP_CACHE=0                    # 1 = cache live responses to ./.linkup_cache for repeatable demos

# ---- MLflow tracing ----
TRACING_ENABLED=1
MLFLOW_TRACKING_URI=              # 'databricks' in the workspace; default is a local sqlite store
MLFLOW_EXPERIMENT_NAME=crumbly    # on Databricks use an absolute path, e.g. /Shared/crumbly
MLFLOW_UC_TRACES=0                # 1 = store traces in UC tables (UC_CATALOG.UC_SCHEMA); needs the next var
MLFLOW_TRACING_SQL_WAREHOUSE_ID=
